# LilyGo T-Dongle-C5: ESP32-C5HR8, 16 MB flash, USB Serial/JTAG as the only USB port.
CONFIG_IDF_TARGET="esp32c5"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# The protocol and the logs share the built-in USB serial port.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Bluetooth LE through NimBLE, as a broadcaster only: legacy advertising,
# no connections, no scanning.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT=n
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
# The controller's power-on default, in case anything were ever sent before
# the firmware sets the power itself. -15 dBm is the lowest this option really
# gives: in ESP-IDF 5.5 the three lower choices (-18, -21, -24) fall back to
# 0 dBm. The firmware sets -24 dBm at boot, and sets and reads back the power
# before each transmission.
CONFIG_BT_LE_DFT_TX_POWER_LEVEL_N15=y
